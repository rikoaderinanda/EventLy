# Copy to .env for docker compose. .env is git-ignored: never commit real secrets.
# These defaults are for the local stack only.
POSTGRES_DB=evently
POSTGRES_USER=evently
POSTGRES_PASSWORD=evently_dev
POSTGRES_PORT=5432
REDIS_PORT=6379
APP_PORT=8080
STORAGE_PORT=8333

# Google sign-in (optional locally). The client id is public, not a secret.
AUTH_GOOGLE_CLIENT_ID=
# Google email that signs in as Root.
AUTH_ROOT_EMAIL=root@evently.test

# Public origin used in invitation links and QR codes, e.g. a tunnel URL to test from a phone.
# Empty = the origin the browser used (http://127.0.0.1:8080), which phones and WhatsApp can't open.
APP_PUBLIC_BASE_URL=

# Where the browser loads photos and invitation media from (signed URLs to the local storage).
# To test from a phone, expose port 8333 with a tunnel too and put its https:// address here.
STORAGE_PUBLIC_URL=http://127.0.0.1:8333
