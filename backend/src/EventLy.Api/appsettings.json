{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": ""
  },
  "Cache": {
    "Provider": "Memory",
    "RedisConnection": ""
  },
  "ApiDocs": {
    "Enabled": false
  },
  "Auth": {
    "Jwt": {
      "Issuer": "evently",
      "Audience": "evently-api",
      "SigningKey": "",
      "AccessTokenMinutes": 15
    },
    "GoogleClientId": "",
    "RootEmail": "",
    "DevSignInEnabled": false,
    "RefreshTokenDays": 14
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 10
  },
  "Legal": {
    "TermsVersion": "2026-09-29"
  },
  "Payments": {
    "Provider": "Fake",
    "CheckoutMinutes": 1440
  },
  "Maintenance": {
    "Key": ""
  },
  "App": {
    "PublicBaseUrl": ""
  },
  "Storage": {
    "ServiceUrl": "",
    "PublicUrl": "",
    "Bucket": "evently",
    "Region": "us-east-1",
    "AccessKey": "",
    "SecretKey": ""
  }
}
